# Template of environment variables this app needs on Vercel (production).
#
# 1. Copy this file:  Copy-Item vercel.env.example vercel.env
# 2. Fill in real values in vercel.env (this file is gitignored - never commit it).
# 3. Push them to Vercel (run from the project folder, after `vercel login` + `vercel link`):
#
#      Get-Content vercel.env | ForEach-Object {
#          if ($_ -match '^([A-Z0-9_]+)=(.*)$') {
#              $Matches[2] | vercel env add $Matches[1] production
#          }
#      }
#
# Secrets (APP_KEY, database credentials) must only live here / on Vercel, never in vercel.json.

# php artisan key:generate --show
APP_KEY=base64:REPLACE_ME
APP_URL=https://your-domain.com

# PostgreSQL connection (Neon, Supabase, etc.)
DB_CONNECTION=pgsql
DB_HOST=your-db-host
DB_PORT=5432
DB_DATABASE=your-db-name
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

# Only needed while seeding the database locally (php artisan db:seed)
APP_ADMIN_PASSWORD=change-me
